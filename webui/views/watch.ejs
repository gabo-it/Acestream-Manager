<div class="max-w-3xl mx-auto">
  <% if (!embed) { %>
    <h1 class="text-xl font-bold mb-4"><%= channel.name %></h1>
  <% } %>

  <div class="rounded-lg border border-amber-900 bg-amber-950/30 text-amber-300 px-4 py-3 text-sm mb-4">
    <%= t('watch.browser_compat_banner') %>
  </div>

  <div class="rounded-xl overflow-hidden border border-slate-800 bg-black aspect-video">
    <video id="player" controls class="w-full h-full"></video>
  </div>

  <p id="player-status" class="text-xs text-slate-500 mt-2"></p>

  <div id="stream-info" class="hidden mt-3 rounded-lg border border-slate-800 bg-slate-900/60 px-4 py-3 text-xs text-slate-400 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1"></div>

  <p id="player-error" class="hidden mt-4 rounded-lg border border-red-900 bg-red-950/40 text-red-300 px-4 py-3 text-sm">
    <span id="player-error-detail"></span><br />
    <%= t('watch.fallback_before') %>
    <a href="<%= streamUrl %>" class="underline"><%= t('watch.open_direct') %></a>
    <%= t('watch.fallback_after') %>
    <br /><span class="text-xs text-red-400"><%= t('watch.codec_hint') %></span>
    <br /><span class="text-xs text-amber-400"><%= t('watch.chromium_hint') %></span>
  </p>

  <div class="flex gap-2 mt-3">
    <a href="<%= channel.id ? '/channels/' + channel.id + '/vlc.m3u' : '/vlc-direct.m3u?id=' + channel.acestream_id + '&name=' + encodeURIComponent(channel.name) %>"
       class="flex-1 text-center rounded-lg border border-slate-800 hover:bg-slate-800 transition px-4 py-2 text-sm font-medium">
      <%= t('watch.open_vlc') %>
    </a>
    <a href="acestream://<%= channel.acestream_id %>"
       class="flex-1 text-center rounded-lg border border-slate-800 hover:bg-slate-800 transition px-4 py-2 text-sm font-medium">
      <%= t('watch.open_aceplayer') %>
    </a>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/mpegts.js@1.7.3/dist/mpegts.min.js"></script>
<script>
  (function () {
    // Solo MPEG-TS via acexy: infrastruttura collaudata (usata anche dalle
    // playlist).
    var tsUrl = <%- JSON.stringify(tsProxyUrl) %>;
    var acestreamId = <%- JSON.stringify(channel.acestream_id) %>;
    var video = document.getElementById('player');
    var errorBox = document.getElementById('player-error');
    var errorDetail = document.getElementById('player-error-detail');
    var statusEl = document.getElementById('player-status');
    var player = null;
    var retryCount = 0;
    var MAX_RETRIES = 3;
    var handlingError = false;
    var finished = false;
    var destroyToken = 0; // vedi destroyPlayer(): invalida i riferimenti in volo
    var triedNoAudio = false;
    var triedRemux = false;
    var pendingRetry = null; // { fn, delay } — un retry rimandato mentre la scheda è in background

    function setStatus(msg) {
      statusEl.textContent = msg;
    }

    // Se la scheda va in background, Chrome può mettere in pausa un video
    // senza audio per risparmiare energia ("video-only background media was
    // paused to save power"). Trattarlo come un errore da ritentare crea un
    // loop di retry mentre l'utente non sta nemmeno guardando la pagina,
    // che può arrivare a saturare le connessioni verso il nostro stesso
    // proxy. Quando la scheda è nascosta, i retry vengono sospesi e ripresi
    // solo al ritorno in primo piano.
    function scheduleRetry(fn, delay) {
      if (document.hidden) {
        pendingRetry = { fn: fn, delay: delay };
        return;
      }
      setTimeout(fn, delay);
    }

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && pendingRetry) {
        var r = pendingRetry;
        pendingRetry = null;
        setTimeout(r.fn, r.delay);
      }
    });

    function showError(detail) {
      finished = true;
      destroyPlayer();
      if (detail) errorDetail.textContent = detail;
      errorBox.classList.remove('hidden');
      console.error('[watch] Riproduzione fallita:', detail || '(nessun dettaglio)');
    }

    function destroyPlayer() {
      destroyToken += 1; // qualunque callback async legata al player precedente si autoriconosce "stale"
      var infoEl = document.getElementById('stream-info');
      if (infoEl) { infoEl.classList.add('hidden'); infoEl.innerHTML = ''; }
      var p = player;
      player = null;
      if (p) {
        // player.destroy() può avere lavoro asincrono interno in corso
        // (letture di rete, callback di appendBuffer già in coda): se
        // resettiamo il <video> nello stesso istante, quel lavoro può
        // ancora tentare di usare riferimenti che stiamo azzerando,
        // causando "Cannot read properties of null (reading 'emit')".
        // defer di un tick per lasciarlo assestare prima del reset.
        try { p.destroy(); } catch (e) { /* ignora */ }
      }
      setTimeout(function () {
        try {
          video.pause();
          video.removeAttribute('src');
          video.load();
        } catch (e) { /* ignora */ }
      }, 0);
    }

    var remuxRetryCount = 0;
    var MAX_REMUX_RETRIES = 3;

    // Ultimo fallback, solo quando anche mpegts.js senza audio ha fallito:
    // remux server-side a MP4 frammentato (via ffmpeg), riprodotto dal
    // <video> nativamente, senza passare da MediaSource Extensions. Non
    // tocca il percorso mpegts.js sopra, che resta l'unico usato finché
    // funziona (Firefox in pratica non arriva mai qui). Ha un suo ciclo di
    // retry separato: un intoppo transitorio della sorgente (comune sui
    // rilanci P2P meno puliti) non deve significare resa immediata — ogni
    // retry apre un processo ffmpeg nuovo di zecca.
    function tryRemuxFallback() {
      destroyPlayer();
      setTimeout(startRemux, 100);
    }

    function startRemux() {
      setStatus(<%- JSON.stringify(t('watch.trying_remux')) %> + (remuxRetryCount > 0 ? ' (' + remuxRetryCount + '/' + MAX_REMUX_RETRIES + ')' : ''));
      video.src = '/stream-proxy/fmp4/' + acestreamId + '?_r=' + Date.now();
      video.load();
      var onError = function () {
        video.removeEventListener('error', onError);
        var detail = video.error ? ('code ' + video.error.code + (video.error.message ? ' — ' + video.error.message : '')) : '(nessun dettaglio)';
        console.error('[watch] remux: errore nativo del <video>:', detail);

        if (remuxRetryCount < MAX_REMUX_RETRIES) {
          remuxRetryCount += 1;
          try { video.pause(); video.removeAttribute('src'); video.load(); } catch (e) { /* ignora */ }
          scheduleRetry(startRemux, 1500);
          return;
        }
        showError(<%- JSON.stringify(t('watch.remux_failed')) %>);
      };
      video.addEventListener('error', onError);
      video.play().then(function () {
        setStatus(<%- JSON.stringify(t('watch.playing_remux')) %>);
      }).catch(function (err) {
        if (err && err.name === 'NotAllowedError') {
          setStatus(<%- JSON.stringify(t('watch.click_to_play')) %>);
        } else {
          console.warn('[watch] play() remux fallito:', err && err.message);
        }
      });
    }

    function startPlayer() {
      if (typeof mpegts === 'undefined') {
        showError('mpegts.js non caricato.');
        return;
      }
      if (!mpegts.getFeatureList().mseLivePlayback) {
        showError('Questo browser non supporta MediaSource Extensions per lo streaming live.');
        return;
      }
      handlingError = false;
      var myToken = destroyToken;
      var config = { type: 'mse', isLive: true, url: tsUrl };
      if (triedNoAudio) config.hasAudio = false;
      player = mpegts.createPlayer(config);
      player.attachMediaElement(video);
      player.load();

      // Info tecniche del flusso, mostrate solo se l'API le fornisce
      // davvero — mpegts.js documenta questi due eventi ma non elenca
      // ufficialmente ogni campo dei rispettivi oggetti, quindi
      // controlliamo l'esistenza di ognuno prima di mostrarlo invece di
      // assumerne la presenza.
      var streamInfoEl = document.getElementById('stream-info');
      var lastMediaInfo = null;
      function renderStreamInfo() {
        if (myToken !== destroyToken) return;
        var mi = lastMediaInfo;
        if (!mi) return;
        var rows = [];
        if (mi.videoCodec) rows.push([<%- JSON.stringify(t('watch.info_video_codec')) %>, mi.videoCodec]);
        if (mi.width && mi.height) rows.push([<%- JSON.stringify(t('watch.info_resolution')) %>, mi.width + '×' + mi.height]);
        if (mi.fps) rows.push([<%- JSON.stringify(t('watch.info_fps')) %>, Math.round(mi.fps * 10) / 10 + ' fps']);
        if (mi.videoDataRate) rows.push([<%- JSON.stringify(t('watch.info_video_bitrate')) %>, Math.round(mi.videoDataRate) + ' kbps']);
        if (mi.audioCodec) rows.push([<%- JSON.stringify(t('watch.info_audio_codec')) %>, mi.audioCodec]);
        if (mi.audioSampleRate) rows.push([<%- JSON.stringify(t('watch.info_audio_rate')) %>, mi.audioSampleRate + ' Hz']);
        if (mi.audioChannelCount) rows.push([<%- JSON.stringify(t('watch.info_audio_channels')) %>, mi.audioChannelCount]);
        if (mi.audioDataRate) rows.push([<%- JSON.stringify(t('watch.info_audio_bitrate')) %>, Math.round(mi.audioDataRate) + ' kbps']);
        if (!rows.length) return;
        streamInfoEl.innerHTML = rows.map(function (r) {
          return '<div><span class="text-slate-600">' + r[0] + ':</span> <span class="text-slate-300">' + r[1] + '</span></div>';
        }).join('');
        streamInfoEl.classList.remove('hidden');
      }
      player.on(mpegts.Events.MEDIA_INFO, function (mi) {
        if (myToken !== destroyToken) return;
        lastMediaInfo = mi;
        renderStreamInfo();
      });
      // "Velocità" (throughput di rete reale) cambia nel tempo, quindi va
      // ri-renderizzata ad ogni evento invece che una volta sola come i
      // dati del codec — che restano fissi per tutta la sessione.
      player.on(mpegts.Events.STATISTICS_INFO, function (si) {
        if (myToken !== destroyToken || !si) return;
        var el = document.getElementById('stream-info-speed');
        var label = <%- JSON.stringify(t('watch.info_speed')) %>;
        var text = typeof si.speed === 'number' ? Math.round(si.speed) + ' KB/s' : null;
        if (!text) return;
        if (!el) {
          streamInfoEl.insertAdjacentHTML('beforeend', '<div id="stream-info-speed"><span class="text-slate-600">' + label + ':</span> <span class="text-slate-300"></span></div>');
          el = document.getElementById('stream-info-speed');
        }
        el.querySelector('span:last-child').textContent = text;
        streamInfoEl.classList.remove('hidden');
      });
      player.on(mpegts.Events.ERROR, function (type, detail) {
        if (myToken !== destroyToken) return; // player già sostituito, ignora
        if (finished || handlingError) return;
        handlingError = true;

        // "NetworkError" (connessione lenta/instabile) e "MediaError" dopo
        // che la riproduzione era già partita (blocco dati transitorio, non
        // necessariamente un codec incompatibile) vengono ritentati
        // automaticamente qualche volta prima di mostrare l'errore finale.
        var isRetryable = type === 'NetworkError' || type === 'MediaError';
        if (isRetryable && retryCount < MAX_RETRIES) {
          retryCount += 1;
          setStatus(<%- JSON.stringify(t('watch.retrying')) %> + ' (' + retryCount + '/' + MAX_RETRIES + ')');
          destroyPlayer();
          scheduleRetry(startPlayer, 1500);
          return;
        }
        // Esauriti i retry normali: se non l'abbiamo ancora fatto, tentiamo
        // una volta sola SENZA audio. Alcuni flussi hanno una traccia audio
        // in un formato che mpegts.js non sa demuxare (es. AC-3/Dolby
        // Digital, segnalato nel PMT come "dati privati" generici): il
        // player si blocca subito dopo il primo frame video proprio a
        // causa di quella traccia. Se il problema è quello, escludere
        // l'audio sblocca almeno il video (senza sonoro).
        if (type === 'MediaError' && !triedNoAudio) {
          triedNoAudio = true;
          setStatus(<%- JSON.stringify(t('watch.trying_no_audio')) %>);
          destroyPlayer();
          scheduleRetry(startPlayer, 1000);
          return;
        }
        // Anche senza audio non ha funzionato: prima di arrenderci,
        // proviamo il remux server-side (bypassa del tutto MSE/mpegts.js).
        if (!triedRemux) {
          triedRemux = true;
          tryRemuxFallback();
          return;
        }
        showError(String(type) + (detail ? ' — ' + detail : ''));
      });
      setStatus(<%- JSON.stringify(t('watch.click_to_play')) %>);
      video.play().then(function () {
        if (triedNoAudio) setStatus(<%- JSON.stringify(t('watch.playing_no_audio')) %>);
      }).catch(function (err) {
        // Il blocco autoplay del browser (nessuna interazione dell'utente
        // ancora) non è un errore di riproduzione: il player è pronto,
        // serve solo un click sui controlli. Non conta come retry/errore.
        if (err && err.name === 'NotAllowedError') {
          setStatus(<%- JSON.stringify(t('watch.click_to_play')) %>);
        } else {
          console.warn('[watch] play() fallito:', err && err.message);
        }
      });
    }

    // Guardia globale: alcune versioni di mpegts.js possono generare un
    // rifiuto di promise non gestito nei suoi internals durante un
    // destroy/reload ravvicinato — lo logghiamo senza far interrompere il
    // resto della pagina.
    window.addEventListener('unhandledrejection', function (event) {
      var msg = event.reason && event.reason.message ? event.reason.message : String(event.reason);
      if (msg && msg.indexOf('emit') !== -1) {
        console.warn('[watch] Rifiuto interno mpegts.js ignorato:', msg);
        event.preventDefault();
      }
    });

    setStatus(<%- JSON.stringify(t('watch.trying_ts')) %>);
    startPlayer();

    window.addEventListener('beforeunload', destroyPlayer);
  })();
</script>

<% if (embed) { %>
<script>
  // Comunica al genitore (che ci incorpora in un iframe, es. il tab TV)
  // l'altezza reale del contenuto, così può ridimensionare l'iframe di
  // conseguenza invece di tagliarci dentro un riquadro di altezza fissa
  // indovinata — niente più scroll interno. ResizeObserver reagisce da
  // solo a qualunque cambiamento (es. la comparsa del box errore),
  // senza bisogno di richiamarlo manualmente ad ogni singolo stato.
  (function () {
    function sendHeight() {
      window.parent.postMessage({ type: 'acestream-embed-height', height: document.body.scrollHeight }, window.location.origin);
    }
    if (window.ResizeObserver) {
      new ResizeObserver(sendHeight).observe(document.body);
    } else {
      window.addEventListener('load', sendHeight);
      setInterval(sendHeight, 1000); // fallback per browser molto datati senza ResizeObserver
    }
    sendHeight();
  })();
</script>
<% } %>

<h1 class="text-2xl font-bold mb-2"><%= t('sites.title') %></h1>
<p class="text-sm text-slate-400 mb-6 max-w-3xl"><%= t('sites.subtitle') %></p>

<div class="grid gap-3 mb-8">
  <% sites.forEach(function(site) { %>
    <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-4">
      <div class="flex items-start gap-4 flex-wrap">
        <div class="flex-1 min-w-[260px]">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-medium"><%= site.name %></span>
            <% if (site.is_builtin) { %>
              <span class="text-xs rounded-full bg-slate-900 border border-slate-700 px-2 py-0.5 text-slate-400"><%= t('sites.builtin') %></span>
            <% } %>
            <% if (site.use_warp) { %>
              <span class="text-xs rounded-full bg-amber-950/60 border border-amber-700/60 px-2 py-0.5 text-amber-300">WARP</span>
            <% } %>
            <% if (!site.enabled) { %>
              <span class="text-xs rounded-full bg-slate-900 border border-slate-700 px-2 py-0.5 text-slate-500"><%= t('sites.off') %></span>
            <% } %>
          </div>
          <% if (site.is_builtin) { %>
            <p class="text-xs text-slate-500 mt-1"><%= t('sites.catalog_desc') %></p>
          <% } else { %>
            <p class="text-xs text-slate-500 font-mono mt-1 break-all"><%= site.url_template %></p>
          <% } %>
          <p class="test-out text-xs mt-2 hidden" data-site="<%= site.id %>"></p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <% if (!site.is_builtin) { %>
            <button type="button" class="test-btn rounded-lg border border-slate-700 hover:bg-slate-800 transition px-3 py-1.5 text-xs" data-id="<%= site.id %>">
              <%= t('sites.test_btn') %>
            </button>
          <% } %>
          <form method="POST" action="/search-sites/<%= site.id %>/update" class="flex items-center gap-4 flex-wrap">
            <label class="flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer">
              <input type="checkbox" name="enabled" class="rounded bg-slate-950 border-slate-700" <%= site.enabled ? 'checked' : '' %> />
              <%= t('sites.enabled_label') %>
            </label>
            <% if (!site.is_builtin) { %>
              <label class="flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer" title="<%= t('sites.warp_hint') %>">
                <input type="checkbox" name="use_warp" class="rounded bg-slate-950 border-slate-700" <%= site.use_warp ? 'checked' : '' %> />
                <%= t('sites.warp_label') %>
              </label>
            <% } %>
            <button class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-3 py-1.5 text-xs font-medium">
              <%= t('form.save') %>
            </button>
          </form>
          <% if (!site.is_builtin) { %>
            <form method="POST" action="/search-sites/<%= site.id %>/delete"
                  onsubmit="return confirm('<%= t('sites.confirm_delete') %>')">
              <button class="text-red-400 hover:text-red-300 transition text-xs px-2 py-1.5" title="<%= t('sites.delete_btn') %>">🗑</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 max-w-3xl">
  <h2 class="font-medium mb-3"><%= t('sites.add_title') %></h2>
  <form method="POST" action="/search-sites/add" class="grid gap-3 sm:grid-cols-2 items-start">
    <div>
      <label class="block text-xs text-slate-500 mb-1"><%= t('sites.name_label') %></label>
      <input name="name" required maxlength="60" placeholder="Streamz"
             class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-1"><%= t('sites.url_label') %></label>
      <input name="url_template" required maxlength="500" placeholder="https://example.com/search?q={query}"
             class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 text-sm font-mono" />
    </div>
    <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer" title="<%= t('sites.warp_hint') %>">
      <input type="checkbox" name="use_warp" class="rounded bg-slate-950 border-slate-700" />
      <%= t('sites.warp_label') %>
    </label>
    <button class="justify-self-start sm:justify-self-end rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-4 py-2 text-sm font-medium">
      <%= t('sites.add_btn') %>
    </button>
    <p class="text-xs text-slate-500 sm:col-span-2"><%= t('sites.url_hint') %></p>
    <p class="text-xs text-slate-500 sm:col-span-2"><%= t('sites.warp_hint') %></p>
  </form>
</div>

<div class="mt-4 flex items-center gap-2 text-xs text-slate-500 max-w-3xl">
  <span><%= t('sites.test_sample_label') %></span>
  <input id="sample-query" value="Inter Milan" maxlength="120"
         class="rounded-lg bg-slate-950 border border-slate-800 px-2 py-1 text-xs w-48" />
</div>

<script>
  (function () {
    var TESTING = <%- JSON.stringify(t('sites.testing')) %>;
    var FOUND = <%- JSON.stringify(t('sites.test_found')) %>;
    var FAILED = <%- JSON.stringify(t('sites.test_failed')) %>;

    document.querySelectorAll('.test-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.dataset.id;
        var card = btn.closest('.rounded-xl');
        var out = card.querySelector('.test-out');
        var sample = (document.getElementById('sample-query') || {}).value || 'Inter Milan';
        var original = btn.textContent;
        btn.disabled = true;
        btn.textContent = TESTING;
        fetch('/search-sites/' + id + '/test?q=' + encodeURIComponent(sample))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            out.classList.remove('hidden');
            if (d.ok) {
              var extra = d.names && d.names.length ? ' — ' + d.names.join(' · ') : '';
              out.textContent = FOUND.replace('{n}', d.count) + extra;
              out.className = 'test-out text-xs mt-2 text-emerald-300';
            } else {
              out.textContent = FAILED + ': ' + (d.error || '?');
              out.className = 'test-out text-xs mt-2 text-red-300';
            }
          })
          .catch(function (err) {
            out.classList.remove('hidden');
            out.textContent = FAILED + ': ' + (err && err.message ? err.message : 'network error');
            out.className = 'test-out text-xs mt-2 text-red-300';
          })
          .finally(function () {
            btn.disabled = false;
            btn.textContent = original;
          });
      });
    });
  })();
</script>

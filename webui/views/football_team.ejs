<a href="/football" class="text-sm text-indigo-400 hover:text-indigo-300 underline mb-4 inline-block">
  ← <%= t('football.back_to_search') %>
</a>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold"><%= t('football.matches_title') %></h1>
  <% if (name) { %>
    <form method="POST" action="/football/favorite">
      <input type="hidden" name="country" value="<%= country %>" />
      <input type="hidden" name="slug" value="<%= slug %>" />
      <input type="hidden" name="name" value="<%= name %>" />
      <button class="rounded-lg border border-amber-800 text-amber-300 hover:bg-amber-950/40 transition px-3 py-1.5 text-sm">
        ★ <%= t('football.set_favorite') %>
      </button>
    </form>
  <% } %>
</div>

<% if (error) { %>
  <div class="rounded-lg border border-red-900 bg-red-950/40 text-red-300 px-4 py-3 text-sm mb-6">
    <%= t('football.search_failed') %>: <%= error %>
  </div>
<% } else if (matches.length === 0) { %>
  <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-8 text-center text-slate-400">
    <%= t('football.no_matches') %>
  </div>
<% } else { %>
  <div class="grid gap-2">
    <% matches.forEach(function(m) { %>
      <a href="/football/match?url=<%= encodeURIComponent(m.url) %>"
         class="rounded-xl border border-slate-800 bg-slate-800/60 p-4 hover:border-indigo-500 transition block">
        <%= m.title %>
      </a>
    <% }); %>
  </div>
<% } %>

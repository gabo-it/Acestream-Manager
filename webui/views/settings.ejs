<h1 class="text-2xl font-bold mb-6"><%= t('settings.title') %></h1>

<form method="POST" action="/settings" class="max-w-2xl grid gap-6 rounded-xl border border-slate-800 bg-slate-800/60 p-6">

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('settings.acexy_url_label') %></label>
    <div class="flex gap-2 items-center">
      <input name="acexy_base_url" value="<%= acexyBaseUrl %>" data-engine-check
             class="flex-1 rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500 font-mono text-sm" />
      <span class="text-xs whitespace-nowrap text-slate-500" data-status-for="acexy_base_url">…</span>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= t('settings.acexy_url_help') %></p>
  </div>

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('settings.http_playback_url_label') %></label>
    <div class="flex gap-2 items-center">
      <input name="http_playback_url" value="<%= httpPlaybackUrl %>" placeholder="<%= acexyBaseUrl %>" data-engine-check data-optional="1"
             class="flex-1 rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500 font-mono text-sm" />
      <span class="text-xs whitespace-nowrap text-slate-500" data-status-for="http_playback_url">…</span>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= t('settings.http_playback_url_help') %></p>
  </div>

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('settings.engine_public_url_label') %></label>
    <div class="flex gap-2 items-center">
      <input name="engine_public_url" value="<%= enginePublicUrl %>" placeholder="http://192.168.1.50:6677" data-engine-check
             class="flex-1 rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500 font-mono text-sm" />
      <span class="text-xs whitespace-nowrap text-slate-500" data-status-for="engine_public_url">…</span>
    </div>
    <p class="text-xs text-slate-500 mt-1"><%= t('settings.engine_public_url_help') %></p>
  </div>

  <div class="flex gap-3">
    <button class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-4 py-2 text-sm font-medium">
      <%= t('settings.save') %>
    </button>
  </div>
</form>

<div class="max-w-2xl mt-6 rounded-xl border border-slate-800 bg-slate-800/60 p-6">
  <h2 class="font-semibold mb-1"><%= t('settings.backup_title') %></h2>
  <p class="text-xs text-slate-500 mb-4"><%= t('settings.backup_help') %></p>
  <div class="flex gap-3 items-center flex-wrap">
    <a href="/settings/export" class="rounded-lg border border-slate-800 hover:bg-slate-800 transition px-4 py-2 text-sm">
      <%= t('settings.export') %>
    </a>
    <form method="POST" action="/settings/import" enctype="multipart/form-data" class="flex gap-2 items-center"
          onsubmit="return confirm(<%- JSON.stringify(t('settings.import_confirm')) %>);">
      <input type="file" name="file" accept="application/json" required
             class="text-sm text-slate-400 file:mr-2 file:rounded-lg file:border-0 file:bg-slate-800 file:px-3 file:py-1.5 file:text-slate-200 file:text-sm" />
      <button class="rounded-lg border border-red-900 text-red-400 hover:bg-red-950/40 transition px-4 py-2 text-sm">
        <%= t('settings.import') %>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    var MSG_CHECKING = <%- JSON.stringify(t('settings.engine_check_checking')) %>;
    var MSG_UNREACHABLE = <%- JSON.stringify(t('settings.engine_check_unreachable')) %>;
    var MSG_FALLBACK = <%- JSON.stringify(t('settings.engine_check_fallback')) %>;
    var MSG_REACHABLE = <%- JSON.stringify(t('settings.engine_check_reachable')) %>;

    async function checkEngine(input, statusEl, optional) {
      var url = input.value.trim();
      if (!url) {
        if (optional) {
          statusEl.textContent = MSG_FALLBACK;
          statusEl.className = 'text-xs whitespace-nowrap text-slate-500';
        } else {
          statusEl.textContent = '';
        }
        return;
      }
      statusEl.textContent = MSG_CHECKING;
      statusEl.className = 'text-xs whitespace-nowrap text-slate-500';
      try {
        var res = await fetch('/settings/check-engine?url=' + encodeURIComponent(url));
        var data = await res.json();
        if (data.ok) {
          statusEl.textContent = data.version ? ('✓ v' + data.version) : '✓ ' + MSG_REACHABLE;
          statusEl.className = 'text-xs whitespace-nowrap text-emerald-400';
        } else {
          statusEl.textContent = '✗ ' + MSG_UNREACHABLE;
          statusEl.className = 'text-xs whitespace-nowrap text-red-400';
        }
      } catch (e) {
        statusEl.textContent = '✗ ' + MSG_UNREACHABLE;
        statusEl.className = 'text-xs whitespace-nowrap text-red-400';
      }
    }

    document.querySelectorAll('[data-engine-check]').forEach(function (input) {
      var statusEl = document.querySelector('[data-status-for="' + input.name + '"]');
      if (!statusEl) return;
      var optional = input.dataset.optional === '1';
      checkEngine(input, statusEl, optional);
      var debounceTimer;
      input.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () { checkEngine(input, statusEl, optional); }, 800);
      });
    });
  })();
</script>

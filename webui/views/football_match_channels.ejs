<a href="/football/match?url=<%= encodeURIComponent(matchUrl) %>" class="text-sm text-indigo-400 hover:text-indigo-300 underline mb-4 inline-block">
  ← <%= t('football.back_to_match') %>
</a>

<h1 class="text-2xl font-bold mb-2"><%= t('football.find_channels_title') %></h1>
<% if (matchTitle) { %>
  <p class="text-sm text-slate-400 mb-2"><%= matchTitle %></p>
<% } %>

<% if (error === 'no-title') { %>
  <div class="rounded-lg border border-amber-900 bg-amber-950/40 text-amber-200 px-4 py-3 text-sm mb-6">
    <%= t('football.find_channels_no_title') %>
    <a href="<%= matchUrl %>" target="_blank" rel="noopener" class="text-indigo-400 underline ml-1"><%= t('football.open_original') %></a>
  </div>
<% } else { %>
  <% if (queries.length) { %>
    <div class="flex items-center flex-wrap gap-1.5 mb-4">
      <span class="text-xs text-slate-500"><%= t('football.find_channels_subtitle') %></span>
      <% queries.forEach(function(q) { %>
        <span class="rounded-full bg-slate-800 px-2.5 py-1 text-xs text-slate-300 font-mono"><%= q %></span>
      <% }); %>
    </div>
  <% } %>

  <% if (error === 'search-unavailable') { %>
    <div class="rounded-lg border border-red-900 bg-red-950/40 text-red-300 px-4 py-3 text-sm mb-6">
      <%= t('football.find_channels_unavailable') %>
    </div>
  <% } %>

  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <p class="text-sm text-slate-500"><%= results.length %> <%= t('search.results_for') %> "<%= matchTitle || t('football.find_channels_title') %>"</p>
    <% if (results.length > 0) { %>
      <div class="flex items-center gap-3">
        <label class="flex items-center gap-2 text-sm text-slate-400">
          <input type="checkbox" id="mc-select-all" class="rounded bg-slate-950 border-slate-700" onchange="toggleMcAll(this)" />
          <%= t('sources.select_all') %>
        </label>
        <button type="button" onclick="importMcSelected()" class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-3 py-1.5 text-sm font-medium">
          <%= t('search.import_selected') %>
        </button>
      </div>
    <% } %>
  </div>

  <div class="grid gap-3">
    <% results.forEach(function(r, i) { %>
      <% const streamUrl = `${(acexyBaseUrl || '').replace(/\/$/, '')}/ace/getstream?id=${r.infohash}`; %>
      <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-4 flex items-center gap-4">
        <input type="checkbox" class="mc-checkbox rounded bg-slate-950 border-slate-700 flex-shrink-0" data-index="<%= i %>" />
        <img src="<%= r.icon || 'https://placehold.co/64x64/1e293b/94a3b8?text=%20' %>"
             class="w-12 h-12 rounded-lg object-cover bg-slate-800 flex-shrink-0" alt="" />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="w-2 h-2 rounded-full flex-shrink-0 <%= r.status === 2 ? 'bg-emerald-500' : 'bg-amber-500' %>"
                  title="<%= r.status === 2 ? t('search.available') : t('search.uncertain') %>"></span>
            <span class="font-medium truncate"><%= r.name %></span>
            <% if (r.relevant) { %>
              <span class="text-xs rounded-full bg-indigo-950/60 border border-indigo-700/60 px-2 py-0.5 text-indigo-300">⚽ <%= t('football.find_channels_relevant') %></span>
            <% } %>
            <% if (r.categories) { %>
              <span class="text-xs rounded-full bg-slate-800 px-2 py-0.5 text-slate-400"><%= r.categories %></span>
            <% } %>
          </div>
          <div class="text-xs text-slate-500 font-mono truncate"><%= r.infohash %></div>
          <div class="flex items-center gap-3 mt-2 text-xs">
            <a href="/watch-direct?id=<%= r.infohash %>&name=<%= encodeURIComponent(r.name) %>" class="text-slate-400 hover:text-indigo-400 transition"><%= t('channels.http') %></a>
            <a href="/vlc-direct.m3u?id=<%= r.infohash %>&name=<%= encodeURIComponent(r.name) %>" class="text-slate-400 hover:text-indigo-400 transition"><%= t('channels.vlc') %></a>
            <a href="acestream://<%= r.infohash %>" class="text-slate-400 hover:text-indigo-400 transition"><%= t('channels.aceplayer') %></a>
            <button type="button" onclick="copyMcLink('<%= streamUrl %>', this)" class="text-slate-400 hover:text-indigo-400 transition">
              <%= t('channels.copy_link') %>
            </button>
          </div>
        </div>
        <form method="POST" action="/search/import" class="flex-shrink-0">
          <input type="hidden" name="name" value="<%= r.name %>" />
          <input type="hidden" name="infohash" value="<%= r.infohash %>" />
          <input type="hidden" name="category" value="<%= r.categories %>" />
          <input type="hidden" name="logo_url" value="<%= r.icon %>" />
          <button class="text-sm text-indigo-400 hover:text-indigo-300 transition px-3 py-1.5 rounded-lg border border-slate-800">
            <%= t('search.add') %>
          </button>
        </form>
      </div>
    <% }); %>
    <% if (results.length === 0 && !error) { %>
      <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-8 text-center text-slate-400">
        <%= t('search.no_results') %>
      </div>
    <% } %>
  </div>
<% } %>

<script>
  var mcResults = <%- JSON.stringify(results || []) %>;
  var mcMatchUrl = <%- JSON.stringify(matchUrl || '') %>;

  function copyMcLink(url, btn) {
    copyToClipboard(url).then(function () {
      var original = btn.textContent;
      btn.textContent = <%- JSON.stringify(t('channels.copied')) %>;
      setTimeout(function () { btn.textContent = original; }, 1500);
    }).catch(function (err) {
      console.error('[copy] fallito:', err);
      alert(url);
    });
  }

  function toggleMcAll(checkbox) {
    document.querySelectorAll('.mc-checkbox').forEach(function (cb) { cb.checked = checkbox.checked; });
  }

  // Dopo l'import si torna alla pagina della partita: i canali appena
  // aggiunti compaiono subito tra i link "In your playlist".
  function importMcSelected() {
    var selected = [];
    document.querySelectorAll('.mc-checkbox:checked').forEach(function (cb) {
      var r = mcResults[parseInt(cb.dataset.index, 10)];
      selected.push({ name: r.name, infohash: r.infohash, category: r.categories, logo_url: r.icon });
    });
    if (selected.length === 0) return;

    fetch('/search/import-selected', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ results: selected }),
    })
      .then(function (r) { return r.json(); })
      .then(function () {
        window.location.href = mcMatchUrl
          ? '/football/match?url=' + encodeURIComponent(mcMatchUrl)
          : '/channels';
      })
      .catch(function (err) { alert('Error: ' + err.message); });
  }
</script>

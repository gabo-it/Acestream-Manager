<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · AceStream Manager</title>
  <script>
    // Tema scelto prima del primo paint (niente flash): dark è il default,
    // "light" aggiunge la classe a <html> che attiva public/light.css.
    try { if (localStorage.getItem('asm-theme') === 'light') document.documentElement.classList.add('light'); } catch (e) {}
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#020617" />
  <link rel="icon" type="image/png" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="stylesheet" href="/light.css" />
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
    .sidebar-link { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem; color: #94a3b8; font-size: 0.875rem; transition: all 0.15s; }
    .sidebar-link:hover { color: #e2e8f0; background: rgba(30, 41, 59, 0.8); }
    .sidebar-link.active { color: #a5b4fc; background: rgba(49, 46, 129, 0.4); font-weight: 500; }
    .sidebar-group-label { padding: 0 0.75rem; margin-bottom: 0.25rem; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #475569; }
  </style>
  <script src="/copy.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
<% if (!embed) { %>
  <div class="lg:flex">
    <!-- Overlay mobile, per chiudere la sidebar toccando fuori -->
    <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/60 z-20 lg:hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="w-64 flex-shrink-0 bg-slate-900 border-r border-slate-800 fixed lg:sticky top-0 h-screen overflow-y-auto z-30 -translate-x-full lg:translate-x-0 transition-transform duration-200">
      <div class="p-4 border-b border-slate-800">
        <a href="/" class="flex items-center gap-2.5 font-bold text-base tracking-tight">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 shadow-md shadow-indigo-950/60 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.25"
                 stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5">
              <rect x="2" y="7" width="20" height="14" rx="2"></rect>
              <polyline points="17 2 12 7 7 2"></polyline>
            </svg>
          </span>
          AceStream Manager
        </a>
      </div>

      <nav class="p-3">
        <div class="mb-5">
          <a href="/" data-nav data-nav-exact class="sidebar-link">🏠 <%= t('nav.dashboard') %></a>
        </div>

        <div class="mb-5">
          <div class="sidebar-group-label"><%= t('nav.group_watch') %></div>
          <a href="/tv" data-nav class="sidebar-link">📺 <%= t('nav.tv') %></a>
        </div>

        <div class="mb-5">
          <div class="sidebar-group-label"><%= t('nav.group_manage') %></div>
          <a href="/channels" data-nav class="sidebar-link">🗂️ <%= t('nav.channels') %></a>
          <a href="/sources" data-nav class="sidebar-link">📡 <%= t('nav.sources') %></a>
          <a href="/search" data-nav class="sidebar-link">🔍 <%= t('nav.search') %></a>
          <a href="/search-sites" data-nav class="sidebar-link">🔎 <%= t('nav.search_sites') %></a>
          <a href="/football" data-nav class="sidebar-link">⚽ <%= t('nav.football') %></a>
          <a href="/playlist" data-nav class="sidebar-link">📃 <%= t('nav.playlist') %></a>
        </div>

        <div>
          <div class="sidebar-group-label"><%= t('nav.group_system') %></div>
          <a href="/addons" data-nav class="sidebar-link">🔌 <%= t('nav.addons') %></a>
          <a href="/stats" data-nav class="sidebar-link">📊 <%= t('nav.stats') %></a>
          <a href="/jobs" data-nav class="sidebar-link">🩺 <%= t('nav.health') %></a>
          <a href="/settings" data-nav class="sidebar-link">⚙️ <%= t('nav.settings') %></a>
          <button type="button" id="theme-toggle" class="sidebar-link w-full text-left mt-1" title="Toggle light / dark theme">
            🌓 <span id="theme-toggle-label"><%= t('nav.theme_light') %></span>
          </button>
        </div>

        <% if (updateBadge) { %>
          <!-- Nuova versione disponibile su GitHub (controllo in background,
               badge calcolato lato server solo dalla cache — vedi server.js). -->
          <div class="mt-3 mx-1 rounded-lg border border-emerald-700/60 bg-emerald-950/40 px-2.5 py-2 text-[11px] leading-snug">
            <a href="<%= updateBadge.url %>" target="_blank" rel="noopener" class="text-emerald-300 hover:text-emerald-200 font-medium flex items-center gap-1.5">
              ⬆️ <%= t('update.badge') %>
            </a>
            <div class="text-emerald-500/90 mt-0.5 font-mono">v<%= updateBadge.current %> → v<%= updateBadge.latest %></div>
            <form method="POST" action="/settings/update-check/dismiss" class="mt-1">
              <button type="submit" class="text-emerald-600 hover:text-emerald-400 hover:underline"><%= t('update.dismiss') %></button>
            </form>
          </div>
        <% } %>
      </nav>
    </aside>

    <!-- Contenuto principale -->
    <div class="flex-1 min-w-0">
      <!-- Barra superiore, solo mobile: bottone per aprire la sidebar -->
      <div class="lg:hidden sticky top-0 z-10 bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center gap-3">
        <button id="sidebar-toggle" class="text-slate-400 hover:text-white transition" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="font-semibold">AceStream Manager</span>
      </div>

      <main class="max-w-6xl mx-auto px-4 py-8">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="mb-6 rounded-lg border border-indigo-800 bg-indigo-950/50 text-indigo-200 px-4 py-3 text-sm">
            <%= flash %>
          </div>
        <% } %>
        <%- body %>
      </main>

      <footer class="max-w-6xl mx-auto px-4 py-8 mt-8 border-t border-slate-900 text-center text-xs text-slate-600">
        <p>
          AceStream Manager <span class="text-slate-500">v<%= appVersion %></span>
          &nbsp;·&nbsp;
          <a href="https://github.com/gabo-it/Acestream-Manager" target="_blank" rel="noopener" class="hover:text-indigo-400 transition">GitHub</a>
        </p>
      </footer>
    </div>
  </div>

  <script>
    (function () {
      // Evidenzia la voce della sidebar corrispondente alla pagina corrente.
      // Il link Dashboard ("/") usa match esatto (data-nav-exact) — altrimenti,
      // dato che ogni percorso inizia per "/", risulterebbe sempre "attivo".
      var path = window.location.pathname;
      document.querySelectorAll('[data-nav]').forEach(function (link) {
        var href = link.getAttribute('href');
        var exact = link.hasAttribute('data-nav-exact');
        var isActive = exact ? path === href : (path === href || path.startsWith(href + '/'));
        if (isActive) link.classList.add('active');
      });

      // Toggle sidebar su mobile/tablet.
      var sidebar = document.getElementById('sidebar');
      var overlay = document.getElementById('sidebar-overlay');
      var toggleBtn = document.getElementById('sidebar-toggle');
      function openSidebar() {
        sidebar.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
      }
      function closeSidebar() {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      }
      if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
      if (overlay) overlay.addEventListener('click', closeSidebar);

      // Toggle tema chiaro/scuro: classe "light" su <html> (public/light.css)
      // + preferenza in localStorage. L'etichetta mostra la destinazione.
      var themeBtn = document.getElementById('theme-toggle');
      var themeLabel = document.getElementById('theme-toggle-label');
      function syncThemeLabel() {
        if (themeLabel) themeLabel.textContent = document.documentElement.classList.contains('light')
          ? <%- JSON.stringify(t('nav.theme_dark')) %>
          : <%- JSON.stringify(t('nav.theme_light')) %>;
      }
      if (themeBtn) {
        syncThemeLabel();
        themeBtn.addEventListener('click', function () {
          var light = document.documentElement.classList.toggle('light');
          try { localStorage.setItem('asm-theme', light ? 'light' : 'dark'); } catch (e) {}
          syncThemeLabel();
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', light ? '#f1f5f9' : '#020617');
        });
      }

      // Service worker: solo pagine complete (il player in embed/iframe non
      // ne ha bisogno e un SW in più dentro l'iframe sarebbe solo rumore).
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    })();
  </script>
<% } else { %>
  <main class="px-2 py-2">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="mb-6 rounded-lg border border-indigo-800 bg-indigo-950/50 text-indigo-200 px-4 py-3 text-sm">
        <%= flash %>
      </div>
    <% } %>
    <%- body %>
  </main>
<% } %>
</body>
</html>

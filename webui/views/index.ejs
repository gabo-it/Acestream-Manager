<div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
  <h1 class="text-3xl font-bold tracking-tight">
    <%= t('channels.title') %>
    <span class="text-slate-500 text-lg font-normal ml-1">(<%= channels.length %>)</span>
  </h1>
  <div class="flex items-center gap-2">
    <form id="channel-search-form" method="GET" action="/channels" class="flex items-center rounded-xl bg-slate-900/80 border border-slate-800 focus-within:border-indigo-500/60 transition overflow-hidden">
      <% if (filter) { %><input type="hidden" name="filter" value="<%= filter %>" /><% } %>
      <input type="hidden" name="ds" id="guide-ds" disabled />
      <input type="text" name="q" value="<%= q || '' %>" placeholder="<%= t('channels.search_placeholder') %>"
             class="bg-transparent px-3.5 py-2.5 text-sm focus:outline-none w-56 placeholder:text-slate-600" />
      <button class="px-3.5 py-2.5 text-slate-500 hover:text-indigo-400 transition"><%= t('channels.search_btn') %></button>
    </form>
    <div class="relative">
      <button type="button" onclick="toggleCheckSchedule()" title="<%= t('channels.schedule_tooltip') %>" class="rounded-xl border border-slate-800 hover:border-slate-700 hover:bg-slate-900 transition px-3 py-2.5 text-sm text-slate-400 whitespace-nowrap">
        ⏱️ <%= checkMode !== 'off' ? t('channels.schedule_active') : t('channels.schedule_btn') %>
      </button>
      <div id="check-schedule-panel" class="hidden absolute right-0 top-full mt-2 z-20 w-72 rounded-xl border border-slate-800 bg-slate-900 shadow-xl p-4">
        <form method="POST" action="/channels/schedule-check" class="grid gap-3">
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="mode" value="off" <%= checkMode === 'off' ? 'checked' : '' %> class="text-indigo-600" />
            <%= t('channels.schedule_off') %>
          </label>
          <label class="flex items-center gap-2 text-sm flex-wrap">
            <input type="radio" name="mode" value="interval" <%= checkMode === 'interval' ? 'checked' : '' %> class="text-indigo-600" />
            <%= t('channels.schedule_interval') %>
            <select name="interval_hours" class="rounded-lg bg-slate-950 border border-slate-800 px-2 py-1 text-xs">
              <% ['1', '3', '6', '12', '24'].forEach(function(h) { %>
                <option value="<%= h %>" <%= checkIntervalHours === h ? 'selected' : '' %>><%= h %>h</option>
              <% }); %>
            </select>
          </label>
          <label class="flex items-center gap-2 text-sm flex-wrap">
            <input type="radio" name="mode" value="time" <%= checkMode === 'time' ? 'checked' : '' %> class="text-indigo-600" />
            <%= t('channels.schedule_time') %>
            <input type="time" name="time" value="<%= checkTime %>" class="rounded-lg bg-slate-950 border border-slate-800 px-2 py-1 text-xs" />
          </label>
          <% if (lastCheckAllAt) { %>
            <p class="text-xs text-slate-500 pt-1 border-t border-slate-800"><%= t('channels.schedule_last_run') %>: <span id="last-check-time" data-ts="<%= lastCheckAllAt %>">—</span></p>
          <% } %>
          <button class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-3 py-2 text-sm font-medium">
            <%= t('settings.save') %>
          </button>
        </form>
      </div>
    </div>
    <form method="POST" action="/channels/check-all">
      <button class="rounded-xl border border-slate-800 hover:border-slate-700 hover:bg-slate-900 transition px-4 py-2.5 text-sm font-medium text-slate-300">
        <%= t('channels.check_all') %>
      </button>
    </form>
    <a href="/channels/new" class="rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 hover:from-indigo-400 hover:to-indigo-600 transition shadow-lg shadow-indigo-950/50 px-4 py-2.5 text-sm font-semibold">
      <%= t('channels.new') %>
    </a>
  </div>
</div>

<script>
  function toggleCheckSchedule() {
    document.getElementById('check-schedule-panel').classList.toggle('hidden');
  }
  document.addEventListener('click', function (e) {
    var panel = document.getElementById('check-schedule-panel');
    if (!panel || panel.classList.contains('hidden')) return;
    if (!panel.contains(e.target) && !e.target.closest('[onclick="toggleCheckSchedule()"]')) {
      panel.classList.add('hidden');
    }
  });
  var lastCheckEl = document.getElementById('last-check-time');
  if (lastCheckEl) {
    var ts = parseInt(lastCheckEl.dataset.ts, 10);
    if (ts) lastCheckEl.textContent = new Date(ts).toLocaleString('en-US');
  }
</script>

<div class="mb-6 flex items-center gap-x-6 gap-y-2 flex-wrap">
  <% if (filter === 'without_epg') { %>
    <span class="inline-flex items-center gap-2 text-xs rounded-full bg-amber-950/60 border border-amber-800/60 text-amber-300 px-3 py-1.5">
      <%= t('channels.filter_without_epg_active') %>
      <a href="/channels<%= q ? '?q=' + encodeURIComponent(q) : '' %>" class="hover:text-white transition">✕</a>
    </span>
  <% } else { %>
    <a href="/channels?filter=without_epg" class="text-xs text-slate-500 hover:text-indigo-400 transition">
      <%= t('channels.filter_without_epg_link') %>
    </a>
  <% } %>
  <label class="inline-flex items-center gap-2 text-xs text-slate-400 cursor-pointer" title="<%= t('channels.guide_hint') %>">
    <input type="checkbox" id="guide-checkbox" name="guide" value="1" form="channel-search-form" <%= guideOn ? 'checked' : '' %> class="rounded bg-slate-950 border-slate-700" />
    <%= t('channels.guide_checkbox') %>
  </label>
</div>

<!-- Preview del matching in blocco canali ↔ EPG: riempita via JS dopo la
     verifica dei canali (vedi startEpgMatch), niente è salvato finché
     l'utente non preme Apply. -->
<div id="epg-match-panel" class="hidden mb-6 rounded-xl border border-indigo-900/60 bg-slate-900/60 p-4"></div>

<% if (channels.length === 0) { %>
  <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-8 text-center text-slate-400">
    <%= t('channels.empty') %>
    <a href="/sources" class="text-indigo-400 underline"><%= t('nav.sources') %></a> ·
    <a href="/search" class="text-indigo-400 underline"><%= t('nav.search') %></a> ·
    <a href="/channels/new" class="text-indigo-400 underline"><%= t('channels.new') %></a>
  </div>
<% } else { %>
  <form method="POST" action="/channels/bulk-delete" id="bulk-form">
    <div class="flex items-center gap-3 mb-3 text-sm text-slate-400">
      <label class="flex items-center gap-2">
        <input type="checkbox" id="select-all" class="rounded bg-slate-950 border-slate-700" />
        <%= t('channels.select_all') %>
      </label>
      <button type="submit"
              onclick="return confirm('<%= t('channels.delete_confirm') %>');"
              class="rounded-lg border border-red-900 text-red-400 hover:bg-red-950/40 transition px-3 py-1.5">
        <%= t('channels.delete_selected') %>
      </button>
      <button type="button" onclick="startEpgMatch(this)"
              title="<%= t('channels.epg_match_hint') %>"
              class="rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 transition px-3 py-1.5">
        🎯 <%= t('channels.epg_match') %>
      </button>
    </div>

    <div class="grid gap-3">
      <% channels.forEach(function(ch) { %>
        <% const acexy = (acexyBaseUrl || '').replace(/\/$/, ''); %>
        <% const streamUrl = `${acexy}/ace/getstream?id=${ch.acestream_id}`; %>
        <% const dotColor = ch.status === 'online' ? 'bg-emerald-500' : ch.status === 'offline' ? 'bg-red-500' : 'bg-slate-600'; %>
        <div class="group rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/70 to-slate-900/30 hover:border-indigo-500/40 hover:shadow-lg hover:shadow-indigo-950/40 transition-all">
          <div class="p-4 flex items-center gap-4">
            <input type="checkbox" name="ids" value="<%= ch.id %>" class="channel-checkbox rounded bg-slate-950 border-slate-700 flex-shrink-0" />
            <div class="relative flex-shrink-0">
              <img src="<%= ch.logo_url || 'https://placehold.co/64x64/1e293b/94a3b8?text=%20' %>"
                   class="w-12 h-12 rounded-xl object-cover bg-slate-800 ring-1 ring-slate-700/60" alt="" />
              <span class="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full border-2 border-slate-950 <%= dotColor %>" title="<%= ch.status || 'unknown' %>"></span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <button type="button" class="font-semibold truncate group-hover:text-indigo-300 transition text-left"
                        onclick="toggleSchedule(<%= ch.id %>, '<%= ch.tvg_id %>')">
                  <%= ch.name %>
                </button>
                <% if (ch.category) { %>
                  <span class="text-xs rounded-full bg-slate-800/80 px-2 py-0.5 text-slate-400"><%= ch.category %></span>
                <% } %>
                <% if (ch.tvg_id && tvgIdCounts[ch.tvg_id] > 1) { %>
                  <span class="text-xs rounded-full bg-indigo-950/80 text-indigo-300 px-2 py-0.5" title="<%= t('channels.duplicate_hint') %>">
                    <%= tvgIdCounts[ch.tvg_id] %> <%= t('channels.streams_count') %>
                  </span>
                <% } %>
              </div>
              <div class="text-xs text-slate-600 truncate mt-0.5"><%= t('channels.id_label') %>: <%= ch.acestream_id %></div>
              <% const nn = epgByChannel[ch.id]; %>
              <% if (nn && nn.now) { %>
                <div class="mt-1.5 flex items-center gap-1.5 text-sm text-indigo-300 truncate">
                  <span class="relative flex h-1.5 w-1.5 flex-shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-indigo-400"></span>
                  </span>
                  <%= nn.now.title %>
                </div>
              <% } %>
              <% if (nn && nn.next) { %>
                <div class="text-xs text-slate-500 truncate"><%= t('channels.up_next') %>: <%= nn.next.title %></div>
              <% } %>
              <% const gm = guideMatches[ch.id]; %>
              <% if (gm && gm.length) { %>
                <div class="mt-2 rounded-lg border border-amber-900/40 bg-amber-950/20 px-2.5 py-1.5 text-xs">
                  <div class="text-amber-400/80 mb-0.5"><%= t('channels.guide_matches') %></div>
                  <% gm.slice(0, 5).forEach(function(m) { %>
                    <div class="truncate <%= m.stop_ts < Date.now() ? 'text-slate-600' : 'text-slate-300' %>">
                      <span class="font-mono text-slate-500" data-guide-range="<%= m.start_ts %>|<%= m.stop_ts %>">—</span> <%= m.title %>
                    </div>
                  <% }); %>
                  <% if (gm.length > 5) { %><div class="text-slate-500">+<%= gm.length - 5 %> <%= t('channels.guide_more') %></div><% } %>
                </div>
              <% } %>
              <div class="flex items-center gap-3 mt-2.5 text-xs">
                <a href="/watch/<%= ch.id %>" class="text-slate-500 hover:text-indigo-400 transition"><%= t('channels.http') %></a>
                <a href="/channels/<%= ch.id %>/vlc.m3u" class="text-slate-500 hover:text-indigo-400 transition"><%= t('channels.vlc') %></a>
                <a href="acestream://<%= ch.acestream_id %>" class="text-slate-500 hover:text-indigo-400 transition"><%= t('channels.aceplayer') %></a>
                <button type="button" onclick="copyLink('<%= streamUrl %>', this)" class="text-slate-500 hover:text-indigo-400 transition">
                  <%= t('channels.copy_link') %>
                </button>
              </div>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
              <button type="submit" formaction="/channels/<%= ch.id %>/check-status" formmethod="POST"
                      class="text-sm text-slate-400 hover:text-indigo-300 hover:border-indigo-500/40 transition px-3 py-1.5 rounded-lg border border-slate-800">
                <%= t('channels.verify') %>
              </button>
              <button type="button" onclick="toggleTvgSuggest(<%= ch.id %>)"
                      class="text-sm text-slate-400 hover:text-indigo-300 hover:border-indigo-500/40 transition px-3 py-1.5 rounded-lg border border-slate-800">
                <%= t('channels.tvg_suggest') %>
              </button>
              <a href="/channels/new?duplicate_from=<%= ch.id %>" class="text-sm text-slate-400 hover:text-indigo-300 hover:border-indigo-500/40 transition px-3 py-1.5 rounded-lg border border-slate-800">
                <%= t('channels.add_alt_stream') %>
              </a>
              <a href="/channels/<%= ch.id %>/edit" class="text-sm text-slate-400 hover:text-indigo-300 hover:border-indigo-500/40 transition px-3 py-1.5 rounded-lg border border-slate-800">
                <%= t('channels.edit') %>
              </a>
            </div>
          </div>
          <div id="schedule-<%= ch.id %>" class="hidden border-t border-slate-800/80 px-4 py-3 text-sm"></div>
          <div id="tvgsuggest-<%= ch.id %>" class="hidden border-t border-slate-800/80 px-4 py-3 text-sm"></div>
        </div>
      <% }); %>
    </div>
  </form>
<% } %>

<script>
  var i18n = {
    prevDay: <%- JSON.stringify(t('schedule.prev_day')) %>,
    nextDay: <%- JSON.stringify(t('schedule.next_day')) %>,
    noTvgId: <%- JSON.stringify(t('schedule.no_tvg_id')) %>,
    empty: <%- JSON.stringify(t('schedule.empty')) %>,
    loading: <%- JSON.stringify(t('schedule.loading')) %>,
    nowAiring: <%- JSON.stringify(t('schedule.now_airing')) %>,
    copied: <%- JSON.stringify(t('channels.copied')) %>,
    error: <%- JSON.stringify(t('channels.error')) %>,
    tvgNoSuggestions: <%- JSON.stringify(t('channels.tvg_no_suggestions')) %>,
    logoSuggestTitle: <%- JSON.stringify(t('channels.logo_suggest_title')) %>,
    tvgUse: <%- JSON.stringify(t('channels.tvg_use')) %>,
    manualSearchTitle: <%- JSON.stringify(t('channels.manual_search_title')) %>,
    manualSearchPlaceholder: <%- JSON.stringify(t('channels.manual_search_placeholder')) %>,
    manualSearchBtn: <%- JSON.stringify(t('channels.manual_search_btn')) %>,
    manualSearchEmpty: <%- JSON.stringify(t('channels.manual_search_empty')) %>,
    epgMatchRunning: <%- JSON.stringify(t('channels.epg_match_running')) %>,
    epgMatchTitle: <%- JSON.stringify(t('channels.epg_match_title')) %>,
    epgMatchDesc: <%- JSON.stringify(t('channels.epg_match_desc')) %>,
    epgMatchWas: <%- JSON.stringify(t('channels.epg_match_was')) %>,
    epgMatchNoMatch: <%- JSON.stringify(t('channels.epg_match_no_match')) %>,
    epgMatchManualToggle: <%- JSON.stringify(t('channels.epg_match_manual_toggle')) %>,
    epgMatchManualPlaceholder: <%- JSON.stringify(t('channels.epg_match_manual_placeholder')) %>,
    epgMatchSearchBtn: <%- JSON.stringify(t('channels.epg_match_search_btn')) %>,
    epgMatchManualEmpty: <%- JSON.stringify(t('channels.epg_match_manual_empty')) %>,
    epgMatchNoneOption: <%- JSON.stringify(t('channels.epg_match_none_option')) %>,
    epgMatchApplyCount: <%- JSON.stringify(t('channels.epg_match_apply_count')) %>,
    epgMatchCancel: <%- JSON.stringify(t('channels.epg_match_cancel')) %>,
    epgMatchDone: <%- JSON.stringify(t('channels.epg_match_done')) %>,
    epgMatchEmpty: <%- JSON.stringify(t('channels.epg_match_empty')) %>,
    epgMatchError: <%- JSON.stringify(t('channels.epg_match_error')) %>,
  };

  document.getElementById('select-all')?.addEventListener('change', function () {
    document.querySelectorAll('.channel-checkbox').forEach(function (cb) { cb.checked = this.checked; }.bind(this));
  });

  // ---------- Matching in blocco canali ↔ EPG ----------
  // Il bottone "Match EPG" usa i canali selezionati (checkbox) se ce ne
  // sono, altrimenti tutti quelli elencati in pagina. Il lavoro gira lato
  // server a piccoli batch (qui si mostra l'avanzamento); il risultato è
  // SOLO una preview: ogni riga propone il miglior tvg-id trovato nell'EPG
  // importato, correggibile dal dropdown (alternative) o dalla ricerca
  // manuale. Niente viene salvato finché l'utente non preme Apply.

  var epgMatchRows = [];

  function epgMatchEsc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function startEpgMatch(btn) {
    var checked = document.querySelectorAll('.channel-checkbox:checked');
    var boxes = checked.length ? checked : document.querySelectorAll('.channel-checkbox');
    var ids = Array.prototype.map.call(boxes, function (cb) { return parseInt(cb.value, 10); })
      .filter(function (n) { return Number.isFinite(n); });
    if (!ids.length) { alert(i18n.epgMatchEmpty); return; }

    var panel = document.getElementById('epg-match-panel');
    panel.classList.remove('hidden');
    panel.innerHTML = '<p class="text-sm text-slate-400">' + i18n.epgMatchRunning.replace('{done}', '0').replace('{total}', String(ids.length)) + '</p>';
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    epgMatchRows = [];
    var done = 0;
    var BATCH = 8;

    (function next() {
      if (done >= ids.length) { renderEpgMatchPreview(panel); return; }
      var chunk = ids.slice(done, done + BATCH);
      fetch('/channels/epg-match', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: chunk }),
      })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (data) {
          (data.results || []).forEach(function (r) { epgMatchRows.push(r); });
          done += chunk.length;
          panel.innerHTML = '<p class="text-sm text-slate-400">' + i18n.epgMatchRunning.replace('{done}', String(Math.min(done, ids.length))).replace('{total}', String(ids.length)) + '</p>';
          next();
        })
        .catch(function (err) {
          panel.innerHTML = '<p class="text-sm text-red-400">' + i18n.epgMatchError + ': ' + epgMatchEsc(err.message) + '</p>';
        });
    })();
  }

  function closeEpgMatch() {
    var panel = document.getElementById('epg-match-panel');
    panel.classList.add('hidden');
    panel.innerHTML = '';
    epgMatchRows = [];
  }

  function epgMatchOptionHtml(s, selected) {
    var label = (s.displayName || s.tvgId || '?') + ' — ' + Math.round((s.score || 0) * 100) + '%';
    return '<option value="s" data-tvgid="' + epgMatchEsc(s.tvgId || '') + '" data-logo="' + epgMatchEsc(s.logoUrl || '') + '"' + (selected ? ' selected' : '') + '>' + epgMatchEsc(label) + '</option>';
  }

  function renderEpgMatchPreview(panel) {
    if (!epgMatchRows.length) {
      panel.innerHTML = '<p class="text-sm text-slate-400">' + i18n.epgMatchEmpty + '</p>';
      return;
    }

    var html = '';
    html += '<div class="flex items-start justify-between gap-3 mb-3">';
    html += '<div class="min-w-0"><h2 class="text-lg font-semibold">' + epgMatchEsc(i18n.epgMatchTitle) + '</h2>';
    html += '<p class="text-xs text-slate-500 mt-0.5">' + epgMatchEsc(i18n.epgMatchDesc) + '</p></div>';
    html += '<div class="flex items-center gap-2 flex-shrink-0">';
    html += '<button type="button" id="epg-match-apply-btn" onclick="applyEpgMatch(this)" class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-3 py-1.5 text-sm font-medium"></button>';
    html += '<button type="button" onclick="closeEpgMatch()" class="rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 transition px-3 py-1.5 text-sm">' + epgMatchEsc(i18n.epgMatchCancel) + '</button>';
    html += '</div></div>';

    html += '<div class="grid gap-2">';
    epgMatchRows.forEach(function (r, idx) {
      var hasSuggestions = r.suggestions && r.suggestions.length;
      html += '<div class="epg-match-row rounded-lg border border-slate-800 bg-slate-900/60 p-3" data-idx="' + idx + '">';
      html += '<div class="flex items-center gap-3 flex-wrap">';
      html += '<input type="checkbox" class="epg-match-include rounded bg-slate-950 border-slate-700 flex-shrink-0"' + (hasSuggestions ? ' checked' : '') + ' onchange="onEpgMatchIncludeChange(this)" title="' + epgMatchEsc(i18n.epgMatchDesc) + '" />';
      html += '<div class="min-w-0 flex-1 basis-48">';
      html += '<div class="font-medium text-sm truncate">' + epgMatchEsc(r.name) + '</div>';
      if (r.currentTvgId) {
        html += '<div class="text-xs text-slate-600 truncate">' + epgMatchEsc(i18n.epgMatchWas) + ': <span class="font-mono">' + epgMatchEsc(r.currentTvgId) + '</span></div>';
      }
      html += '</div>';
      html += '<div class="flex items-center gap-2 flex-1 basis-80 min-w-0">';
      html += '<img class="epg-match-logo w-7 h-7 rounded object-cover bg-slate-800 ring-1 ring-slate-700/60 flex-shrink-0 hidden" alt="" onerror="this.classList.add(\'hidden\')" />';
      html += '<select class="epg-match-pick flex-1 min-w-0 rounded-lg bg-slate-950 border border-slate-800 px-2 py-1.5 text-xs focus:outline-none focus:border-indigo-500" onchange="onEpgMatchPickChange(this)">';
      if (hasSuggestions) {
        r.suggestions.forEach(function (s, si) { html += epgMatchOptionHtml(s, si === 0); });
      }
      html += '<option value="" data-tvgid="" data-logo="">' + epgMatchEsc(i18n.epgMatchNoneOption) + '</option>';
      html += '</select>';
      html += '</div>';
      html += '</div>';
      // Riga 2: ricerca manuale nell'EPG (chiusa di default; aperta e con
      // il testo "nessun match" quando il matching automatico non ha
      // proposte per questo canale).
      html += '<div class="mt-2">';
      html += '<button type="button" class="epg-match-manual-toggle text-xs text-slate-500 hover:text-indigo-400 transition">🔍 ' + epgMatchEsc(hasSuggestions ? i18n.epgMatchManualToggle : i18n.epgMatchNoMatch) + '</button>';
      html += '<div class="epg-match-manual-box' + (hasSuggestions ? ' hidden' : '') + ' mt-2">';
      html += '<div class="flex gap-2">';
      html += '<input type="text" class="epg-match-manual-input flex-1 rounded-lg bg-slate-950 border border-slate-800 px-2 py-1 text-xs focus:outline-none focus:border-indigo-500" placeholder="' + epgMatchEsc(i18n.epgMatchManualPlaceholder) + '" />';
      html += '<button type="button" class="epg-match-manual-btn text-xs text-indigo-400 hover:text-indigo-300 px-2 py-1 rounded border border-slate-800">' + epgMatchEsc(i18n.epgMatchSearchBtn) + '</button>';
      html += '</div>';
      html += '<div class="epg-match-manual-results mt-1.5 grid gap-1"></div>';
      html += '</div>';
      html += '</div>';
      html += '</div>';
    });
    html += '</div>';

    panel.innerHTML = html;

    panel.querySelectorAll('.epg-match-row').forEach(function (rowEl) {
      setupEpgMatchManualSearch(rowEl);
      // Stato iniziale del pick (e del logo affianco): la prima proposta.
      var sel = rowEl.querySelector('.epg-match-pick');
      syncEpgMatchLogo(rowEl, sel);
    });
    updateEpgMatchApplyLabel();
  }

  function syncEpgMatchLogo(rowEl, sel) {
    var img = rowEl.querySelector('.epg-match-logo');
    var opt = sel.options[sel.selectedIndex];
    var logo = opt ? (opt.dataset.logo || '') : '';
    if (logo) {
      img.src = logo;
      img.classList.remove('hidden');
    } else {
      img.removeAttribute('src');
      img.classList.add('hidden');
    }
  }

  function onEpgMatchPickChange(sel) {
    syncEpgMatchLogo(sel.closest('.epg-match-row'), sel);
  }

  function onEpgMatchIncludeChange() {
    updateEpgMatchApplyLabel();
  }

  function updateEpgMatchApplyLabel() {
    var btn = document.getElementById('epg-match-apply-btn');
    if (!btn) return;
    var count = document.querySelectorAll('.epg-match-include:checked').length;
    btn.textContent = i18n.epgMatchApplyCount.replace('{count}', String(count));
    btn.disabled = count === 0;
    btn.classList.toggle('opacity-50', count === 0);
  }

  function setManualPick(rowEl, res) {
    var sel = rowEl.querySelector('.epg-match-pick');
    var old = sel.querySelector('option[data-manual="1"]');
    if (old) old.remove();
    var opt = document.createElement('option');
    opt.value = 'manual';
    opt.dataset.manual = '1';
    opt.dataset.tvgid = res.tvgId || '';
    opt.dataset.logo = res.logoUrl || '';
    opt.textContent = '✓ ' + (res.displayName || res.tvgId || '?');
    sel.appendChild(opt);
    sel.value = 'manual';
    syncEpgMatchLogo(rowEl, sel);
  }

  function setupEpgMatchManualSearch(rowEl) {
    var input = rowEl.querySelector('.epg-match-manual-input');
    var btn = rowEl.querySelector('.epg-match-manual-btn');
    var toggle = rowEl.querySelector('.epg-match-manual-toggle');
    var box = rowEl.querySelector('.epg-match-manual-box');
    var resultsBox = rowEl.querySelector('.epg-match-manual-results');

    if (toggle) toggle.addEventListener('click', function () { box.classList.toggle('hidden'); });

    function run() {
      var q = input.value.trim();
      if (!q) return;
      resultsBox.innerHTML = '<span class="text-xs text-slate-500">' + epgMatchEsc(i18n.loading) + '</span>';
      fetch('/epg-channels/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var results = data.results || [];
          if (!results.length) {
            resultsBox.innerHTML = '<span class="text-xs text-slate-500">' + epgMatchEsc(i18n.epgMatchManualEmpty) + '</span>';
            return;
          }
          resultsBox.innerHTML = '';
          results.forEach(function (res) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'text-left text-xs text-indigo-400 hover:text-indigo-300 truncate';
            b.textContent = (res.displayName || res.tvgId || '?') + '  (' + (res.tvgId || '') + ')';
            b.addEventListener('click', function () { setManualPick(rowEl, res); });
            resultsBox.appendChild(b);
          });
        })
        .catch(function () {
          resultsBox.innerHTML = '<span class="text-xs text-red-400">' + epgMatchEsc(i18n.error) + '</span>';
        });
    }
    if (btn) btn.addEventListener('click', run);
    if (input) input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); run(); } });
  }

  function applyEpgMatch(btn) {
    var assignments = [];
    document.querySelectorAll('.epg-match-row').forEach(function (rowEl) {
      if (!rowEl.querySelector('.epg-match-include').checked) return;
      var idx = parseInt(rowEl.dataset.idx, 10);
      var sel = rowEl.querySelector('.epg-match-pick');
      var opt = sel.options[sel.selectedIndex];
      if (!opt) return;
      assignments.push({
        id: epgMatchRows[idx].id,
        tvgId: opt.dataset.tvgid || '',
        logoUrl: opt.dataset.logo || '',
      });
    });
    if (!assignments.length) return;

    var original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '…';
    fetch('/channels/epg-match/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ assignments: assignments }),
    })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (data) {
        alert(i18n.epgMatchDone.replace('{count}', String(data.applied || 0)));
        window.location.reload();
      })
      .catch(function (err) {
        alert(i18n.epgMatchError + ': ' + err.message);
        btn.disabled = false;
        btn.textContent = original;
      });
  }

  function copyLink(url, btn) {
    copyToClipboard(url).then(function () {
      var original = btn.textContent;
      btn.textContent = i18n.copied;
      setTimeout(function () { btn.textContent = original; }, 1500);
    }).catch(function (err) {
      console.error('[copy] fallito:', err);
      alert(url);
    });
  }

  function formatTime(ts) {
    var d = new Date(ts);
    return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
  }

  // Mezzanotte LOCALE (non UTC) per una data data — il costruttore Date
  // con argomenti separati (anno, mese, giorno) usa sempre il fuso
  // orario del browser, che è esattamente quello che vogliamo: senza
  // questo, un utente in un fuso avanti rispetto a UTC (es. Italia)
  // nelle prime ore del mattino locale vedrebbe ancora la programmazione
  // del giorno UTC precedente, con tutti i programmi già "passati".
  function localMidnight(d) {
    return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
  }

  function formatDayLabel(ts) {
    return new Date(ts).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
  }

  function renderSchedule(panel, channelId, data) {
    if (!data.tvgId) {
      panel.innerHTML = '<p class="text-slate-500">' + i18n.noTvgId + '</p>';
      return;
    }
    var html = '<div class="flex items-center justify-between mb-3">';
    html += '<button type="button" class="text-indigo-400 hover:text-indigo-300 text-xs" onclick="loadSchedule(' + channelId + ', ' + data.prevTs + ')">' + i18n.prevDay + '</button>';
    html += '<span class="text-slate-300 font-medium">' + formatDayLabel(data.ts) + '</span>';
    html += '<button type="button" class="text-indigo-400 hover:text-indigo-300 text-xs" onclick="loadSchedule(' + channelId + ', ' + data.nextTs + ')">' + i18n.nextDay + '</button>';
    html += '</div>';

    if (!data.programs.length) {
      html += '<p class="text-slate-500">' + i18n.empty + '</p>';
    } else {
      html += '<div class="grid gap-1.5">';
      var nowTs = Date.now();
      data.programs.forEach(function (p) {
        var isNowAiring = p.start <= nowTs && p.stop > nowTs;
        html += '<div class="flex gap-3 items-baseline' + (isNowAiring ? ' rounded-lg bg-indigo-950/50 border border-indigo-800/50 px-2 py-1 -mx-2' : '') + '">';
        html += '<span class="text-slate-500 font-mono flex-shrink-0">' + formatTime(p.start) + '–' + formatTime(p.stop) + '</span>';
        html += '<span class="' + (isNowAiring ? 'text-indigo-200 font-medium' : 'text-slate-200') + '">' + p.title + '</span>';
        if (isNowAiring) html += '<span class="text-[10px] font-semibold uppercase text-indigo-400 flex-shrink-0">' + i18n.nowAiring + '</span>';
        html += '</div>';
      });
      html += '</div>';
    }
    panel.innerHTML = html;
  }

  function loadSchedule(channelId, ts) {
    var panel = document.getElementById('schedule-' + channelId);
    panel.innerHTML = '<p class="text-slate-500">' + i18n.loading + '</p>';
    fetch('/channels/' + channelId + '/schedule?ts=' + ts)
      .then(function (r) { return r.json(); })
      .then(function (data) { renderSchedule(panel, channelId, data); })
      .catch(function () { panel.innerHTML = '<p class="text-red-400">' + i18n.error + '</p>'; });
  }

  function toggleSchedule(channelId) {
    var panel = document.getElementById('schedule-' + channelId);
    var isHidden = panel.classList.contains('hidden');
    document.querySelectorAll('[id^="schedule-"]').forEach(function (p) { p.classList.add('hidden'); });
    if (isHidden) {
      panel.classList.remove('hidden');
      if (!panel.dataset.loaded) {
        panel.dataset.loaded = '1';
        loadSchedule(channelId, localMidnight(new Date()));
      }
    }
  }

  function applyTvgSuggestion(channelId, tvgId, logoUrl, btn) {
    var original = btn.textContent;
    btn.textContent = '…';
    btn.disabled = true;
    var body = new URLSearchParams({ tvg_id: tvgId, logo_url: logoUrl || '' });
    fetch('/channels/' + channelId + '/tvg-id', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    })
      .then(function (r) {
        console.log('[tvg-suggest] risposta:', r.status);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (data) {
        console.log('[tvg-suggest] applicato:', data);
        window.location.reload();
      })
      .catch(function (err) {
        console.error('[tvg-suggest] fallito:', err);
        btn.textContent = original;
        btn.disabled = false;
        alert(i18n.error + ': ' + err.message);
      });
  }

  function applyLogoSuggestion(channelId, logoUrl, btn) {
    var original = btn.textContent;
    btn.textContent = '…';
    btn.disabled = true;
    var body = new URLSearchParams({ logo_url: logoUrl });
    fetch('/channels/' + channelId + '/logo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    })
      .then(function (r) {
        console.log('[logo-suggest] risposta:', r.status);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (data) {
        console.log('[logo-suggest] applicato:', data);
        window.location.reload();
      })
      .catch(function (err) {
        console.error('[logo-suggest] fallito:', err);
        btn.textContent = original;
        btn.disabled = false;
        alert(i18n.error + ': ' + err.message);
      });
  }

  function renderTvgSuggestions(panel, channelId, suggestions, logoSuggestions) {
    var html = '';

    if (!suggestions.length) {
      html += '<p class="text-slate-500">' + i18n.tvgNoSuggestions + '</p>';
    } else {
      html += '<div class="grid gap-2 mb-4">';
      suggestions.forEach(function (s) {
        var tvgId = String(s.tvgId || '');
        var logoUrl = String(s.logoUrl || '');
        var displayName = String(s.displayName || tvgId || '?');
        html += '<div class="flex items-center justify-between gap-3">';
        html += '<div class="min-w-0 flex items-center gap-2">';
        if (logoUrl) {
          html += '<img src="' + logoUrl + '" class="w-6 h-6 rounded object-cover bg-slate-800 flex-shrink-0" alt="" />';
        }
        html += '<span class="text-slate-200 truncate">' + displayName + '</span> ';
        html += '<span class="text-slate-500 font-mono text-xs">(' + tvgId + ')</span> ';
        html += '<span class="text-slate-600 text-xs">' + Math.round((s.score || 0) * 100) + '%</span></div>';
        html += '<button type="button" class="tvg-suggest-use text-xs text-indigo-400 hover:text-indigo-300 px-2 py-1 rounded border border-slate-800 flex-shrink-0" ' +
                'data-tvgid="' + tvgId.replace(/"/g, '&quot;') + '" data-logo="' + logoUrl.replace(/"/g, '&quot;') + '">' + i18n.tvgUse + '</button>';
        html += '</div>';
      });
      html += '</div>';
    }

    if (logoSuggestions && logoSuggestions.length) {
      html += '<p class="text-xs text-slate-500 mb-2">' + i18n.logoSuggestTitle + '</p>';
      html += '<div class="flex flex-wrap gap-3">';
      logoSuggestions.forEach(function (l) {
        var icon = String(l.icon || '');
        var name = String(l.name || '');
        if (!icon) return;
        html += '<div class="flex flex-col items-center gap-1">';
        html += '<img src="' + icon + '" class="w-10 h-10 rounded object-cover bg-slate-800" alt="" title="' + name.replace(/"/g, '&quot;') + '" />';
        html += '<button type="button" class="logo-suggest-use text-xs text-indigo-400 hover:text-indigo-300 px-2 py-0.5 rounded border border-slate-800" ' +
                'data-logo="' + icon.replace(/"/g, '&quot;') + '">' + i18n.tvgUse + '</button>';
        html += '</div>';
      });
      html += '</div>';
    }

    if (!html) html = '<p class="text-slate-500">' + i18n.tvgNoSuggestions + '</p>';

    html += '<div class="mt-4 pt-3 border-t border-slate-800">';
    html += '<p class="text-xs text-slate-500 mb-2">' + i18n.manualSearchTitle + '</p>';
    html += '<div class="flex gap-2 mb-2">';
    html += '<input type="text" class="manual-epg-search flex-1 rounded-lg bg-slate-950 border border-slate-800 px-2 py-1 text-xs focus:outline-none focus:border-indigo-500" placeholder="' + i18n.manualSearchPlaceholder + '" />';
    html += '<button type="button" class="manual-epg-search-btn text-xs text-indigo-400 hover:text-indigo-300 px-2 py-1 rounded border border-slate-800">' + i18n.manualSearchBtn + '</button>';
    html += '</div>';
    html += '<div class="manual-epg-results grid gap-1"></div>';
    html += '</div>';

    panel.innerHTML = html;

    panel.querySelectorAll('.tvg-suggest-use').forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyTvgSuggestion(channelId, btn.dataset.tvgid, btn.dataset.logo, btn);
      });
    });
    panel.querySelectorAll('.logo-suggest-use').forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyLogoSuggestion(channelId, btn.dataset.logo, btn);
      });
    });

    var searchInput = panel.querySelector('.manual-epg-search');
    var searchBtn = panel.querySelector('.manual-epg-search-btn');
    var resultsBox = panel.querySelector('.manual-epg-results');

    function runManualSearch() {
      var q = searchInput.value.trim();
      if (!q) return;
      resultsBox.innerHTML = '<p class="text-slate-500 text-xs">' + i18n.loading + '</p>';
      fetch('/epg-channels/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var results = data.results || [];
          if (!results.length) {
            resultsBox.innerHTML = '<p class="text-slate-500 text-xs">' + i18n.manualSearchEmpty + '</p>';
            return;
          }
          var html = '';
          results.forEach(function (r) {
            html += '<div class="flex items-center justify-between gap-2 text-xs">';
            html += '<div class="min-w-0 flex items-center gap-2">';
            if (r.logoUrl) html += '<img src="' + r.logoUrl + '" class="w-5 h-5 rounded object-cover bg-slate-800 flex-shrink-0" alt="" />';
            html += '<span class="text-slate-200 truncate">' + r.displayName + '</span>';
            html += '<span class="text-slate-600 font-mono">(' + r.tvgId + ')</span></div>';
            html += '<button type="button" class="manual-epg-use text-indigo-400 hover:text-indigo-300 px-2 py-0.5 rounded border border-slate-800 flex-shrink-0" ' +
                    'data-tvgid="' + r.tvgId.replace(/"/g, '&quot;') + '" data-logo="' + (r.logoUrl || '').replace(/"/g, '&quot;') + '">' + i18n.tvgUse + '</button>';
            html += '</div>';
          });
          resultsBox.innerHTML = html;
          resultsBox.querySelectorAll('.manual-epg-use').forEach(function (btn) {
            btn.addEventListener('click', function () {
              applyTvgSuggestion(channelId, btn.dataset.tvgid, btn.dataset.logo, btn);
            });
          });
        })
        .catch(function () {
          resultsBox.innerHTML = '<p class="text-red-400 text-xs">' + i18n.error + '</p>';
        });
    }

    if (searchBtn) searchBtn.addEventListener('click', runManualSearch);
    if (searchInput) {
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); runManualSearch(); }
      });
    }
  }

  function toggleTvgSuggest(channelId) {
    var panel = document.getElementById('tvgsuggest-' + channelId);
    var isHidden = panel.classList.contains('hidden');
    document.querySelectorAll('[id^="tvgsuggest-"]').forEach(function (p) { p.classList.add('hidden'); });
    if (isHidden) {
      panel.classList.remove('hidden');
      panel.innerHTML = '<p class="text-slate-500">' + i18n.loading + '</p>';
      fetch('/channels/' + channelId + '/tvg-suggestions')
        .then(function (r) { return r.json(); })
        .then(function (data) { renderTvgSuggestions(panel, channelId, data.suggestions || [], data.logoSuggestions || []); })
        .catch(function () { panel.innerHTML = '<p class="text-red-400">' + i18n.error + '</p>'; });
    }
  }
</script>

<script>
  // Ricerca nel palinsesto del giorno: il browser invia la propria
  // mezzanotte locale ("ds"), perché il container gira in UTC e solo qui
  // si conosce il vero fuso orario dell'utente.
  (function () {
    var form = document.getElementById('channel-search-form');
    var box = document.getElementById('guide-checkbox');
    var ds = document.getElementById('guide-ds');
    if (form && box && ds) {
      form.addEventListener('submit', function () {
        var now = new Date();
        ds.value = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
        ds.disabled = !box.checked;
      });
    }
    document.querySelectorAll('[data-guide-range]').forEach(function (el) {
      var parts = el.dataset.guideRange.split('|').map(function (x) { return parseInt(x, 10); });
      if (parts[0] && parts[1]) el.textContent = formatTime(parts[0]) + '–' + formatTime(parts[1]);
    });
  })();
</script>

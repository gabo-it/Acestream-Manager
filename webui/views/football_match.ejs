<a href="javascript:history.back()" class="text-sm text-indigo-400 hover:text-indigo-300 underline mb-4 inline-block">
  ← <%= t('football.back') %>
</a>

<h1 class="text-2xl font-bold mb-4"><%= t('football.broadcasters_title') %></h1>

<% if (error) { %>
  <div class="rounded-lg border border-red-900 bg-red-950/40 text-red-300 px-4 py-3 text-sm mb-6">
    <%= t('football.search_failed') %>: <%= error %>
  </div>
<% } else if (coverage.length === 0) { %>
  <div class="rounded-xl border border-slate-800 bg-slate-800/60 p-8 text-center text-slate-400">
    <%= t('football.no_broadcasters') %>
    <a href="<%= matchUrl %>" target="_blank" rel="noopener" class="text-indigo-400 underline"><%= t('football.open_original') %></a>.
  </div>
<% } else { %>
  <div class="rounded-xl border border-slate-800 bg-slate-800/60 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-slate-500 border-b border-slate-800 bg-slate-900/60">
          <th class="py-2 px-4 w-1/4"><%= t('football.country') %></th>
          <th class="py-2 px-4"><%= t('football.channels') %></th>
        </tr>
      </thead>
      <tbody>
        <% coverage.forEach(function(row) { %>
          <tr class="border-b border-slate-700/60 last:border-0">
            <td class="py-2 px-4 text-slate-300 font-medium align-top"><%= row.country %></td>
            <td class="py-2 px-4">
              <div class="flex flex-wrap gap-1.5">
                <% row.channels.forEach(function(ch) { %>
                  <span class="rounded-full bg-slate-800 px-2.5 py-1 text-xs text-slate-300"><%= ch %></span>
                <% }); %>
              </div>
              <% if (row.matches && row.matches.length) { %>
                <!-- Reti di questo paese trovate anche nella playlist dell'utente:
                     click e si guarda subito, senza cercare il canale a mano. -->
                <div class="mt-2 pt-2 border-t border-slate-700/40">
                  <p class="text-[10px] uppercase tracking-wide text-slate-500 mb-1.5">⭐ <%= t('football.in_your_playlist') %></p>
                  <div class="flex flex-wrap gap-1.5">
                    <% row.matches.forEach(function(mc) { %>
                      <a href="/watch/<%= mc.id %>" title="<%= mc.name %><%= mc.status === 'offline' ? ' · ' + t('football.watch_offline_hint') : '' %>"
                         class="inline-flex items-center gap-1.5 rounded-full bg-indigo-950/60 border border-indigo-700/60 px-2.5 py-1 text-xs text-indigo-200 hover:border-indigo-400 hover:bg-indigo-900/60 transition">
                        <% if (mc.logo_url) { %>
                          <img src="<%= mc.logo_url %>" alt="" class="w-4 h-4 rounded object-contain" onerror="this.style.display='none'" />
                        <% } %>
                        ▶ <%= mc.name.length > 28 ? mc.name.slice(0, 28) + '…' : mc.name %>
                      </a>
                    <% }); %>
                  </div>
                </div>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="text-xs text-slate-500 mt-4">
    <%= t('football.source_note') %>
    <a href="<%= matchUrl %>" target="_blank" rel="noopener" class="text-indigo-400 underline"><%= t('football.open_original') %></a>.
  </p>
<% } %>

<% const p = channel || prefill || {}; %>
<h1 class="text-2xl font-bold mb-2"><%= channel ? t('form.edit_title') : t('form.new_title') %></h1>
<% if (!channel && prefill) { %>
  <div class="max-w-xl rounded-lg border border-indigo-800 bg-indigo-950/40 text-indigo-200 px-4 py-3 text-sm mb-4">
    <p class="font-medium mb-1"><%= t('form.duplicate_title') %></p>
    <p class="text-indigo-300"><%= t('form.duplicate_note') %></p>
  </div>
<% } %>

<form method="POST" action="<%= channel ? '/channels/' + channel.id + '/edit' : '/channels/new' %>"
      class="max-w-xl grid gap-4 rounded-xl border border-slate-800 bg-slate-800/60 p-6">

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('form.name_label') %></label>
    <input name="name" required value="<%= p.name || '' %>"
           class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500" />
  </div>

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('form.id_label') %></label>
    <input name="acestream_id" required value="<%= channel ? channel.acestream_id : '' %>"
           class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500 font-mono text-sm" />
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm text-slate-400 mb-1"><%= t('form.category_label') %></label>
      <input name="category" value="<%= p.category || '' %>"
             class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500" />
    </div>
    <div>
      <label class="block text-sm text-slate-400 mb-1"><%= t('form.tvg_id_label') %></label>
      <input name="tvg_id" value="<%= p.tvg_id || '' %>"
             class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500" />
    </div>
  </div>

  <div>
    <label class="block text-sm text-slate-400 mb-1"><%= t('form.logo_label') %></label>
    <input name="logo_url" value="<%= p.logo_url || '' %>"
           class="w-full rounded-lg bg-slate-950 border border-slate-800 px-3 py-2 focus:outline-none focus:border-indigo-500" />
  </div>

  <div class="flex gap-3 pt-2">
    <button class="rounded-lg bg-indigo-600 hover:bg-indigo-500 transition px-4 py-2 text-sm font-medium">
      <%= t('form.save') %>
    </button>
    <a href="/" class="rounded-lg border border-slate-800 hover:bg-slate-800 transition px-4 py-2 text-sm">
      <%= t('form.cancel') %>
    </a>
  </div>
</form>

# GitHub username/organization the published images live under (ghcr.io)
GITHUB_OWNER=gabo-it

# --- AceStream engine parameters ---
# Edit here by hand, then run:
#   docker compose up -d
# to recreate the containers with the new values. The webui's Engine tab
# only displays these (read-only) — editing happens here, not there.
HTTP_PORT=6677
P2P_PORT=44556
LIVE_CACHE_TYPE=memory
UPLOAD_LIMIT=200
DOWNLOAD_LIMIT=
ACCESS_TOKEN=
EXTRA_ARGS=
BIND_ALL=1

# Host ports acexy and the webui are published on (container-internal
# ports stay 8080 / 4000 regardless — only the host-side mapping changes).
ACEXY_PORT_EXPOSED=8080
WEBUI_PORT_EXPOSED=4000

# How long acexy waits for the first response from the engine before giving
# up (acexy default: 1s — far too low in practice, per acexy's own docs:
# "must be as low as possible unless your Internet connection is really
# bad"). If the engine needs more than a few seconds to find peers for a
# channel, acexy can give up before the content had a real chance, even
# though the same content plays fine hitting the engine directly (no
# artificial cutoff there). See the troubleshooting section in the README.
ACEXY_NO_RESPONSE_TIMEOUT=30s

# Buffer acexy keeps before handing data to the player. Raising this can
# help with choppy/non-fluid playback compared to hitting the engine
# directly (acexy default: 4.2MiB).
ACEXY_BUFFER_SIZE=4.2MiB

# How long acexy waits with no response from a client before evicting it
# from the pool. Too aggressive and a brief player hiccup (e.g. VLC
# buffering) can get treated as a dead client, causing visible stutter
# (acexy default: 5s).
ACEXY_CLIENT_EVICTION_TIMEOUT=10s

# Pinned acexy release (not :latest, deliberately — an unexpected upstream
# update could change behavior/defaults without warning). Check for new
# releases at https://github.com/Javinator9889/acexy/releases before bumping.
ACEXY_VERSION=0.2.2
